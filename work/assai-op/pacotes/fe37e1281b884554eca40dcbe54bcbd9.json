  {
   "sys_id": "18ce09af1b4a865032822170f54bcb45",
   "name": "CSA - Validação CPF Candidato",
   "type": "onChange",
   "va_supported": "false",
   "ativo": "true",
   "resumo": "No onChange de candidate_cpf, só age se o valor mudou. Tenta limpar uma lista de campos com fields.forEach, mas a variável fields não está declarada no script (o trecho lido não mostra a declaração), o que tende a gerar erro de execução. Depois valida CPF (11 dígitos) ou CNPJ (14 dígitos), rejeita sequências repetidas e confere os dígitos verificadores do CPF; inválido limpa e mostra 'CPF inválido!'; válido formata (máscara de CPF ou CNPJ)."
  },
  {
   "sys_id": "9b00f5d83b2b2a10b28dd047f4e45a34",
   "name": "ALP - RH Default Validation User Change",
   "type": "onChange",
   "va_supported": "false",
   "ativo": "true",
   "resumo": "No onChange, carrega o UI Script x_asat_csc.RhDefaultValidation e chama validate(g_form). A validação em si está no UI Script, não lida aqui."
  },
  {
   "sys_id": "a010f5983b2b2a10b28dd047f4e45a09",
   "name": "ALP - RH Default Validation User Load",
   "type": "onLoad",
   "va_supported": "false",
