 "client_scripts": [
  {
   "name": "EY: Validate CPF",
   "type": "onChange",
   "on": "6fecac721beda510a530426fe54bcb70",
   "va_supported": "true",
   "ui_type": "10",
   "what": "Catalog Client Script onChange que valida CPF por formato. Observação: a regex usa ponto sem escape ('.') entre os grupos, o que no regex casa QUALQUER caractere — então '123x456y789-00' passaria na validação."
  },
  {
   "name": "Ey: Attach mandatory leaves and absences",
   "type": "onSubmit",
