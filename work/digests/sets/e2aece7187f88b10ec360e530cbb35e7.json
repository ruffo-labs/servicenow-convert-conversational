    "Other Studies (e.g., Public, Shift...) [=other_studies]"
   ]
  },
  {
   "name": "vs_union_name",
   "type": "Texto de Linha Única",
   "type_code": "6",
   "label": "Union Name"
  },
  {
   "name": "vs_describe_your_request",
   "type": "Texto de Várias Linhas",
   "type_code": "2",
   "label": "Describe your request"
  }
 ],
 "ui_policies": [
  {
   "name": "EY: Show field",
   "when": "IO:vs_study_typeINunion,other_studies^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "vs_describe_your_request: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: If 'Union'",
   "when": "IO:vs_study_type=union^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "vs_union_name: visible=true,mandatory=true"
   ]
  }
 ],
 "client_scripts": []
}