 "client_scripts": [
  {
   "sys_id": "1bf0719c3b2b2a10b28dd047f4e45ac8",
   "name": "ALP - RH Default Validation User Change",
   "type": "onChange",
   "va_supported": "false",
   "ativo": "true",
   "resumo": "No onChange, carrega o UI Script x_asat_csc.RhDefaultValidation e chama validate(g_form). A validação em si está no UI Script, não lida aqui."
  },
  {
   "sys_id": "2a41b6e63b9f6a10b28dd047f4e45a90",
   "name": "CSA - OnChange ServiceOffering",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange da oferta, troca o rótulo de Attachments conforme a oferta: 'Formulário de inclusão' (adesão à assistência médica para dependentes), 'Evidência da solicitação' (adesão não processada), 'Demonstrativo de pagamento' (cancelamento associado indevidamente) e 'Formulário de cancelamento' (cancelamento de assistência médica)."
  },
  {
   "sys_id": "39687b54873be650182a0d440cbb35cc",
   "name": "CSA - Block Submit OnChange2",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange, se a matrícula do impactado (rh_user_id_impacted) está vazia, limpa service_offering e rh_qual_solicitacao e mostra 'Preencha a matrícula do impactado antes.'. Se a oferta for 'Beneficiário(a) não consegue ser atendido(a)', o motivo for 'problemas_acessar_app' e a admissão for posterior a 28/02/2013, agenda dois setTimeout de 500 ms, um gravando block='true' e outro block='false'; como ambos disparam no mesmo instante, o valor final tende a ser 'false' (o bloqueio por esse caminho pode não valer)."
  },
  {
   "sys_id": "41aafab11bfbec1032822170f54bcb99",
   "name": "ALP - OnChange validate Collab Phone",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "Mesma validação e máscara de telefone aplicada a rh_collaborator_phone."
  },
  {
   "sys_id": "630361ee1b5be810eca40dcbe54bcb83",
   "name": "ALP - OnChange CPF Validate",
   "type": "onChange",
   "va_supported": "false",
   "ativo": "true",
   "resumo": "Mesma validação de CPF (11 dígitos, sequências repetidas, dois dígitos verificadores, formatação), aplicada a rh_dependent_cpf."
  },
  {
   "sys_id": "674b315e879f2a10182a0d440cbb35e2",
   "name": "CSA - Block submitt",
   "type": "onSubmit",
