  {
   "name": "v_name_establishment_store",
   "type": "Texto de Linha Única",
   "type_code": "6",
   "label": "Name of the Establishment / Store"
  },
  {
   "name": "how_many_holidays_would_you_like_to_request",
   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "How many holidays would you like to request?",
