 "variable_sets": [],
 "ui_policies": [
  {
   "name": "EY: If \"Type of request\" is 'change of contact'",
   "when": "IO:type_request=alteracao_dados^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "describe_your_email: visible=true,mandatory=true",
    "describe_your_phone: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: If category is \"Solicitações e dúvidas\"",
   "when": "IO:select_category=requests_inquiries^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "type_request: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Mandatory fields",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "describe_your_order: mandatory=true",
    "country: mandatory=true,readonly=true",
    "company_name: mandatory=true,readonly=true",
    "name_requester: mandatory=true",
    "cnpj: mandatory=true",
    "select_category: mandatory=true",
    "name_company: mandatory=true",
    "email: mandatory=true"
   ]
  },
  {
   "name": "EY: if \"Type of request\" is \"Comprovante; Devoluções; Pagamentos parciais; cancelamento notas;outros\"",
   "when": "IO:type_requestINcomprovante_pagamento,devolucoes,pagamentos_parciais,cancelamemento_notas,outros^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "legenda_notas: visible=true"
   ]
  },
  {
   "name": "EY: If category is \"Envio de informações\"",
   "when": "IO:select_category=sending_information^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "type_request_2: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Read only fields ",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "type_request_2: readonly=true",
    "type_request: readonly=true",
    "describe_your_phone: readonly=true",
    "cnpj: readonly=true",
    "name_requester: readonly=true",
    "attach_comprovantes: readonly=true",
    "email: readonly=true",
    "describe_your_order: readonly=true",
    "country: readonly=true",
    "describe_your_email: readonly=true",
    "select_category: readonly=true"
   ]
  }
 ],
