 "producer_script": "Script do Record Producer de Admissão e Movimentação Internacional. Define requested_for como o usuário logado e grava current.item com o sysparm_id.",
 "variaveis": [
  {
   "name": "v_type_of_payment",
   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "Type of payment",
   "include_none": true,
   "choices": [
    "Union Ticket [=union_ticket]",
    "Sunday Worked [=sunday_worked]",
    "Holiday Rate [=holyday]"
   ]
  },
  {
   "name": "v_company",
   "type": "Referência",
   "type_code": "8",
   "label": "Company",
   "reference": "core_company",
   "ref_qual": "u_brandLIKENatura^ORu_brandLIKEAvon^ORu_brandLIKETBS^ORu_brandLIKEAesop^EQ"
  },
  {
   "name": "v_name_establishment_store_v2",
   "type": "Referência",
   "type_code": "8",
