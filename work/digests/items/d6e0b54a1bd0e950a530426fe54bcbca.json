   "order": "900",
   "perguntas": []
  }
 ],
 "ui_policies": [
  {
   "name": "EY: Mandatory if Holiday",
   "when": "IO:v_type_of_payment=holyday^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_more_holiday_dates: visible=true,mandatory=true",
    "v_holiday_date: visible=true,mandatory=true",
    "how_many_holidays_would_you_like_to_request: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Mandatory if Sunday or Holiday and more date is Yes",
   "when": "IO:v_type_of_payment=holyday^IO:v_more_holiday_dates=Yes^NQIO:v_type_of_payment=sunday_worked^IO:v_more_sunday=Yes^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "vs_add_date: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Mandatory if Union",
   "when": "IO:v_type_of_payment=union_ticket^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_due_date: visible=true",
    "v_type_of_union_payment: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Field more colab",
   "when": "IO:v_type_of_payment=sunday_worked^ORIO:v_type_of_payment=holyday^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "legenda_attention: visible=true",
    "agregar_fechas: visible=true",
    "selecione_a_data_e_o_nome_do_colaborador: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Mandatory if Sunday and Holiday",
   "when": "IO:v_type_of_payment=sunday_worked^ORIO:v_type_of_payment=holyday^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_number_of_employees: visible=true,mandatory=true",
    "v_name_establishment_store_v2: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Mandatory if Sunday worked",
   "when": "IO:v_type_of_payment=sunday_worked^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "how_many_sundays_would_you_like_to_request: visible=true,mandatory=true",
    "v_more_sunday: visible=true,mandatory=true",
    "v_date_of_sunday_worked: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Hide 'Name of the Establishment / Store' Single Line text",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_name_establishment_store: visible=false"
   ]
  },
  {
   "name": "EY: Mandatory fields",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_company: visible=true,mandatory=true",
    "v_type_of_payment: visible=true,mandatory=true"
   ]
  }
 ],
