{
 "sys_id": "5f13e4311bbfd154d1abda4ce54bcb3e",
 "status": "conversacional",
 "motivo": "Intenção única de regularizar título em aberto ou duplicidade de pagamento. Documento (CPF/CNPJ) foi unificado numa nova variável de texto com regex, pois o alvo original (document_number_cpf) tem tipo diferente do que seria removido (document_type, tipo lista); nome/código/e-mail de consultora e franqueado foram mesclados nos campos de consultora, com a policy de TBS reescrita para agir sobre eles. opened_by passa a ser preenchido e ocultado automaticamente, e a policy incondicional de obrigatoriedade virou prop.",
 "divergencias": [
  "limite_formato"
 ],
 "vars": {
