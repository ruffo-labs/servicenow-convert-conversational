  {
   "name": "EY: Hide Exchange",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_exchange: visible=false"
   ]
  },
  {
   "name": "EY: Make Variables ReadOnly",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_purchase_order_number: readonly=true",
    "vs_approval_manager: readonly=true",
    "v_contract_number: readonly=true",
    "v_document_number: readonly=true",
    "v_date_for_which_payment_is_requested: readonly=true",
    "v_currency: readonly=true",
    "v_value: readonly=true",
    "v_ged_process_number: readonly=true"
   ]
  },
  {
   "name": "EY: Obrigatorio",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_currency: mandatory=true",
    "v_contract_number: mandatory=true",
    "vs_approval_manager: mandatory=true",
    "v_purchase_order_number: mandatory=true",
    "v_date_for_which_payment_is_requested: mandatory=true",
    "v_document_number: mandatory=true",
    "v_ged_process_number: mandatory=true",
    "v_value: mandatory=true"
   ]
  }
 ],
