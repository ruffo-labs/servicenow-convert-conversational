   "type_code": "9",
   "label": "Payment's date requested"
  }
 ],
 "ui_policies": [
  {
   "name": "EY: Clear Due Date Ext. v2",
   "when": "IO:v_early_payment_v2=true^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_due_date_extension_v2: visible=false,readonly=true"
   ]
  },
  {
   "name": "EY: Clear Early Payment v2",
   "when": "IO:v_due_date_extension_v2=true^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_early_payment_v2: visible=false,readonly=true"
   ]
  },
  {
   "name": "EY: Variaveis Read Only",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_value: readonly=true",
    "v_form_of_payment: readonly=true",
    "v_document_number_invoice: readonly=true",
    "v_currency: readonly=true",
    "v_type_of_payment: readonly=true",
    "v_payment_s_date_requested: readonly=true",
    "original_expiration_date: readonly=true"
   ]
  }
 ],
 "client_scripts": [
  {
   "name": "EY: Máscara de Moeda",
   "type": "onChange",
   "on": "afee53dc1badad90a530426fe54bcbb4",
   "va_supported": "true",
   "ui_type": "10",
   "what": "Catalog Client Script onChange que formata 'v_value' como moeda pela função formatarMoeda. Observação: a implementação usa parseInt no valor, o que descarta os centavos antes de formatar."
  }
 ]
}