   "type": "Texto de Várias Linhas",
   "type_code": "2",
   "label": "Reason"
  }
 ],
 "variable_sets": [],
 "ui_policies": [
  {
   "name": "EY: Mandatory  and read only fields",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_request_type: mandatory=true"
   ]
  },
  {
   "name": "EY: Request type - individual",
   "when": "IO:v_request_type=individual^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_current_date: visible=true,readonly=true",
    "v_substitute_name: visible=true,mandatory=true",
    "v_start_date: visible=true,mandatory=true",
    "v_branch: visible=true,mandatory=true",
    "v_wage: visible=true",
    "v_id: visible=true,readonly=true",
    "v_company: visible=true,readonly=true",
    "v_replacement_position: visible=true,mandatory=true",
    "v_end_date: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: If date retroactive",
   "when": "IO:v_start_date<javascript:gs.beginningOfToday()^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_retroactive_date: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Request type - massive",
   "when": "IO:v_request_type=mass^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_download_mass_template: visible=true,mandatory=true",
    "v_attach_template: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Hide company2",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_company2: visible=false"
   ]
  }
 ],
