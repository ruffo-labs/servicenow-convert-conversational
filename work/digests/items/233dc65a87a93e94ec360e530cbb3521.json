  {
   "name": "question_explanation_label",
   "type": "Rótulo de Rich Text",
   "type_code": "32",
   "label": "Regulatory training: Training that is mandatory by law, required by the Regulatory Standards (NRs) of the Ministry of Labor\r\nFunctional training: Training related to the Natura Learning Ecosystem"
  },
  {
   "name": "question_training_name",
   "type": "Referência",
   "type_code": "8",
   "label": "Training Name",
   "reference": "x_nasm_hr_training_type",
   "ref_qual": "javascript:\"active=true^training_type=\" + current.variables.question_training_type;"
  },
  {
