 "ui_policies": [
  {
   "name": "EY: Show date fields if adm allowance",
   "when": "IO:v_administrative_allowance=Yes^IO:v_return_maternity_inss=inss_leave^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_administrative_allowance_start_date: visible=true,mandatory=true",
    "v_end_date_of_administrative_allowance: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: If \"Alta antecipada ou benefício em análise\" is \"No\"",
   "when": "IO:v_alta_beneficio_analise=No^IO:v_return_maternity_inss=inss_leave^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_date_of_last_day_of_inss_benefit: visible=true,mandatory=true",
    "v_attach_the_inss_decision_notice: mandatory=true"
   ]
  },
  {
   "name": "EY: If \"Alta antecipada ou benefício em análise\" is \"Yes\"",
   "when": "IO:v_alta_beneficio_analise=Yes^IO:v_return_maternity_inss=inss_leave^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_attach_the_inss_decision_notice: mandatory=false",
    "v_date_of_last_day_of_inss_benefit: "
   ]
  },
  {
   "name": "EY: If \" Retorno Licença maternidade\"",
   "when": "IO:v_return_maternity_inss=return_maternity^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_attach_return_exam: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: If \"Afastamento INSS\"",
   "when": "IO:v_return_maternity_inss=inss_leave^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_requested_medical_report_or_complementary_exam: visible=true,mandatory=true",
    "v_sector: visible=true,mandatory=true",
    "v_date_of_first_visit_to_the_health_space: visible=true,mandatory=true",
    "v_alta_beneficio_analise: visible=true,mandatory=true",
    "employee_return_request: visible=true,mandatory=true",
    "v_administrative_allowance: visible=true,mandatory=true",
    "vs_solicitation_to_whom: visible=true,mandatory=true",
    "v_description: visible=true,mandatory=true",
    "v_attach_return_exam_two: visible=true,mandatory=true",
    "v_date_of_return_to_work_aso_doctor: visible=true,mandatory=true",
    "v_attach_the_inss_decision_notice: visible=true,mandatory=true",
    "v_shift: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Mandatory fields",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_return_maternity_inss: mandatory=true"
   ]
  }
 ],
