 "client_scripts": [
  {
   "sys_id": "0c177d331beefd90347221bbe54bcbcb",
   "name": "ALP - Valida data de desligamento",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange da data de desligamento (dimiss_date), calcula a diferença absoluta em dias até hoje; se passar de 30 dias, limpa o campo e mostra 'Desligamento fora do prazo para expurgo!'; senão esconde o erro."
  },
  {
   "sys_id": "0e6775b31beefd90347221bbe54bcb36",
   "name": "ALP - Função",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "Mesma validação para function_code / function contra lista fixa embutida de ~1.100 códigos."
  },
  {
   "sys_id": "3fcb73ff1b0fca90347221bbe54bcbc7",
   "name": "CSA - Label variaveis Atual",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "false",
   "resumo": "No onChange, conforme a oferta, troca rótulos das variáveis de localização e vaga: para 'Transformação de vaga (com/sem custo)' usa 'da vaga atual' (Localidade, Estabelecimento, Número do CR, Departamento, Regional, Função, Código da função, Quantidade); para 'Aumento de quadro' e 'Fechamento de vaga' usa 'da vaga'."
  },
  {
   "sys_id": "437779b31beefd90347221bbe54bcbd2",
   "name": "ALP - Função (Nova)",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "Mesma validação de código de função de function_code_new contra lista fixa embutida, agora a maior variante (~1.100 códigos): válido grava em function_new; inválido limpa os dois campos e avisa."
