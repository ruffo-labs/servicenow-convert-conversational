   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "What was the time of day of the training received?",
   "include_none": true,
   "choices": [
    "Morning [=question_choice_morning]",
    "Afternoon [=question_choice_afternoon]",
    "Full day [=question_choice_fullday]"
   ]
  },
