 "client_scripts": [
  {
   "sys_id": "24dc12f91baabd5032822170f54bcbc9",
   "name": "ALP - Valida centro de resultado",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange do centro de resultado, exige o formato XXXX-XXX (8 caracteres, com um hífen); se não bater, limpa result_center e mostra erro no campo; se bater, esconde o erro."
  },
  {
   "sys_id": "26dc3ead1b227d5032822170f54bcbc8",
   "name": "ALP - Função",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "Mesma validação para function_code / function contra lista fixa embutida de ~120 códigos."
  },
  {
   "sys_id": "2be103561b67025007caeca12b4bcb72",
   "name": "CSA - CR Atual",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange do CR atual (cr_current), formata o código como XXXX-XXX e chama x_asat_csc.NameDepartamentPersistence.getNameDepartamentPersistence via GlideAjax. Se vier nome, grava em cr_description_current e regrava cr_current formatado; senão limpa ambos e mostra 'Não existe cr informado na base'."
  },
  {
   "sys_id": "38c5e2651b6e3d5032822170f54bcbf6",
   "name": "ALP - CR",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "Mesma consulta de CR via x_asat_csc.NameDepartamentPersistence.getNameDepartamentPersistence, aplicada às variáveis cr e cr_description: formata o CR, busca o nome e preenche a descrição; se não existir, limpa e avisa."
  },
  {
   "sys_id": "491186b71b2231d0347221bbe54bcb97",
   "name": "ALP - Matricula do colaborador desligado",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange da matrícula do colaborador desligado, sai cedo se carregando ou vazio. Usa g_form.getReference em fired_user_registration e grava o campo u_role do registro referenciado na variável function_role (cargo)."
  },
  {
   "sys_id": "5b3fde311beabd5032822170f54bcb3a",
   "name": "ALP - Valida data de desligamento",
   "type": "onChange",
   "va_supported": "true",
