{
 "sys_id": "1c0d5ca81b296150d1abda4ce54bcb2c",
 "title": "VS - Conciliação bancaria",
 "internal_name": "vs_concilia_o_bancaria",
 "description": "Campos relacionados ao item conciliaçao bancaria",
 "usado_por": 1,
 "itens_exemplo": [
  "Conciliação Bancária - Saídas e Entradas de Fornecedores"
 ],
 "variaveis": [
  {
   "name": "v_compensation_type",
   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "Compensation Type",
   "include_none": true,
   "choices": [
    "Compensation Bank Entries [=compensation_bank_entries]",
    "Bank Outgoing Compensation [=bank _outgoing_compensation]"
   ]
  },
  {
   "name": "v_compensation_bank_entries",
   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "Compensation Bank Entries",
   "include_none": true,
   "choices": [
    "Registration of Deposits [=registration_deposits]",
    "Suppliers [=suppliers]"
   ]
  },
  {
   "name": "v_compensa_o_sa_das_banc_rias",
   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "Compensação Saídas Bancárias",
   "include_none": true,
   "choices": [
    "Compensation Taxes [=compensation_taxes]",
    "HR Balance Compensation [=hr_balance]",
    "Suppliers [=suppliers]",
    "Bank Fees [=bank_fees]"
   ]
  },
  {
   "name": "v_approver",
   "type": "Referência",
   "type_code": "8",
   "label": "Approver",
   "reference": "sys_user_grmember",
   "ref_qual": "group=7f47a4a81b6d6150d1abda4ce54bcbc0^EQ"
  }
 ],
 "ui_policies": [
  {
   "name": "if select compensation_bank_entries, hidden the v_compensa_o_sa_das_banc_rias ",
   "when": "IO:v_compensation_type=bank _outgoing_compensation^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_compensa_o_sa_das_banc_rias: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: Obrigatorio",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_approver: mandatory=true",
    "v_compensation_type: mandatory=true"
   ]
  },
  {
   "name": "EY: Somente leitura / case-task",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_compensa_o_sa_das_banc_rias: visible=true,readonly=true",
    "v_compensation_bank_entries: visible=true,readonly=true",
    "v_compensation_type: visible=true,readonly=true",
    "v_approver: visible=true,readonly=true"
   ]
  },
  {
   "name": "if select compensation_bank_entries, hidden the v_compensa_o_sa_das_banc_rias ",
   "when": "IO:v_compensation_type=compensation_bank_entries^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_compensation_bank_entries: visible=true,mandatory=true"
   ]
  }
 ],
 "client_scripts": [
  {
   "name": "EY: Treating bank input and output field",
   "type": "onChange",
   "on": "d07d94ec1b296150d1abda4ce54bcbaa",
   "va_supported": "true",
   "ui_type": "10",
   "what": "Catalog Client Script onChange que trata os campos de entrada e saída bancária conforme o tipo de compensação escolhido ('compensation_bank_entries' ou o oposto), exibindo o campo pertinente."
  }
 ]
}