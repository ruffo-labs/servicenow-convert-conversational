"primeira_analise":{"recomendacao":"manter_formulario","nome":"Solicitar aprovação de valores de prêmios e comissões","short_description":"Aprovação de valores de prêmios e comissões em cargas antes do pagamento","description":"Use para pedir a aprovação dos valores de prêmios ou comissões de uma ou mais cargas (até 5) antes do pagamento, anexando a planilha de cada carga. Uso das células de Remuneração e Pagamentos, Reembolso e Prestação de Contas e Serviços Corporativos. Não use para pedir o pagamento em si de prêmio, comissão, bônus ou campanha (use \"Solicitar pagamento de prêmio ou comissão da Força de Vendas\").","frases_exemplo":["preciso aprovar os valores de comissão da carga","aprovação de premiação antes do pagamento","quero enviar as cargas de prêmio para aprovação","aprovar pagamento de comissão das líderes do ciclo"],"labels":{},"acoes":{},"derivados":[],"scripts_e_policies":[{"nome":"10 UI Policies \"If it is commissions/Awards and loads is N\"","acao":"manter","substituicao":"Continuam no formulário."},{"nome":"EY: Clear Fields / EY: Clear Field loads","acao":"manter","substituicao":"Continuam no formulário."}]}
