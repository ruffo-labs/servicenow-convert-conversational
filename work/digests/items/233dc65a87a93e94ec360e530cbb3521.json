   "label": "Job Title"
  },
  {
   "name": "question_workload",
   "type": "Duração",
   "type_code": "29",
   "label": "Workload"
  }
 ],
 "variable_sets": [
  {
   "sys_id": "bc14ea5e87e57e94ec360e530cbb354a",
   "name": "Selecione os colaboradores presentes no treinamento",
   "order": "900",
   "perguntas": [
    "mrvs_collaborator_name (Referência): Employee (Search by ID, Name, or Email)",
    "mrvs_collaborator_id (Texto de Linha Única): Collaborator ID"
   ]
  }
 ],
 "ui_policies": [
  {
   "name": "[AOOP][Hidden Fields]",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "question_user_director: visible=false",
    "question_user_public: visible=false",
    "question_area_vp: visible=false",
    "question_user_title: visible=false",
    "question_workload: visible=false"
   ]
  },
  {
   "name": "[AOOP][Default Behavior of Fields]",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "question_training_type: mandatory=true",
    "question_user_public: ",
    "question_opened_by: readonly=true",
    "question_collaborator_id: readonly=true",
    "question_training_name: mandatory=true",
    "question_area_vp: ",
    "question_collaborator_email: readonly=true",
    "question_user_director: "
   ]
  },
  {
   "name": "[AOOP][Show fields when Training Type = Functional]",
   "when": "IO:question_training_type=functional_training^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "question_training_time: visible=true,mandatory=true",
    "question_time_label: visible=true",
    "question_training_name: "
   ]
  },
  {
   "name": "[AOOP][Show fields when Training Type = Regulatory]",
   "when": "IO:question_training_type=regulatory_training^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "training_date: visible=true,mandatory=true",
    "training_location: visible=true,mandatory=true",
    "question_training_name: ",
    "mrvs_collaborators_present: visible=true,mandatory=true"
   ]
  }
 ],
 "client_scripts": [
  {
   "name": "[AOOP] Clear Values when Type Changes",
   "type": "onChange",
   "on": "c7ac9a9687e17e94ec360e530cbb35f7",
   "va_supported": "true",
   "ui_type": "10",
   "what": "Catalog Client Script onChange que limpa os campos de horário de treinamento quando o tipo muda."
  }
 ]
