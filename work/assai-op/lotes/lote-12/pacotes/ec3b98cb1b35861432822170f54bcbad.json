 "client_scripts": [
  {
   "sys_id": "03ed9f8c3bcede50b28dd047f4e45ab3",
   "name": "ALP - remove readOnly if null",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange, lê o registro core_company escolhido via GlideRecord. Se a empresa não tem centro de custo (u_cost_center), libera unit_cost_center, torna obrigatório e mostra 'Centro de custo indisponível, preencha manualmente.'; senão deixa somente leitura. Faz o mesmo para o CNPJ (u_cnpj) em unit_cnpj."
  },
  {
   "sys_id": "7034f1183b6b2a10b28dd047f4e45a18",
   "name": "ALP - RH Default Validation User Change",
   "type": "onChange",
   "va_supported": "false",
   "ativo": "true",
   "resumo": "No onChange, carrega o UI Script x_asat_csc.RhDefaultValidation e chama validate(g_form). A validação em si está no UI Script, não lida aqui."
  },
  {
   "sys_id": "7d3475183b6b2a10b28dd047f4e45ac2",
   "name": "ALP - RH Default Validation User Load",
   "type": "onLoad",
   "va_supported": "false",
   "ativo": "true",
   "resumo": "No onLoad, carrega o UI Script x_asat_csc.RhDefaultValidation e chama checkCatalogItem(g_form). A lógica está no UI Script, não lida aqui."
