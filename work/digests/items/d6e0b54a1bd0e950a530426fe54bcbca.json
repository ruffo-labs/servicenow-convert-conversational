   "choices": [
    "4",
    "5",
    "2",
    "3",
    "1"
   ]
  },
  {
   "name": "how_many_sundays_would_you_like_to_request",
   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "How many Sundays would you like to request?",
   "include_none": true,
   "choices": [
    "3 [=v_3]",
    "1 [=v_1]",
    "5 [=v_5]",
    "2 [=v_2]",
    "4 [=v_4]"
   ]
  },
  {
   "name": "v_number_of_employees",
   "type": "Texto de Linha Única",
   "type_code": "6",
   "label": "Number of employees"
  },
  {
