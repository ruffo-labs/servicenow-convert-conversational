nsagem."},{"sys_id":"93f1a1291b0e4a10347221bbe54bcbfa","name":"ALP - Código Beneficio","type":"onChange","cat_variable":"7222b5951b0ac61032822170f54bcb24","applies_catalog":false,"ui_type":"10","script":"No onChange do código do benefício, preenche kit_value conforme a escolha: kit_2 = 301,00; kit_21 = 303,00; kit_14 = 318,00. Valores fixos no script."},{"sys_id":"b76175dc3b2b2a10b28dd047f4e45a72","name":"ALP - RH Default Validation User Change","type":"onChange","cat_variable":"5d4f72d41bcf249032822170f54bcbac","va_supported":false,"ui_type":"10","script":"No onChange, carrega o UI Script x_asat_csc.RhDefaultValidation e chama validate(g_form). A validação em si está no UI Script, não lida aqui."}],"variable_sets":[{"sys_id":"114f72d41bcf249032822170f54bcb7e","title":"Informações do Impactado","internal_name":"rh_infos_impacted_set","order":100,"description":"Conjunto de variável para inserir as informações do impactado.","variaveis":[{"name":"rh_user_id_impacted","type":"6","order":50,"question_text":"Matrícula do impactado"},{"name":"requested_for","type":"8","reference":"u_all_user","reference_qual":"user_nameISNOTEMPTY^user_user_nameISNOTEMPTY^user_web_service_access_only=false^user_nameNOT LIKE$Usuario^EQ","reference_qual_condition":"user_nameISNOTEMPTY^user_user_nameISNOTEMPTY^user_web_service_access_only=false^user_nameNOT LIKE$Usuario^EQ","order":100,"question_text":"Nome do impactado"},{"name":"rh_cpf_impacted","type":"6","order":300,"question_text":"CPF do impactado"},{"name":"rh_email_impacted","type":"26","order":350,"question_text":"Email"},{"name":"rh_date_entry","type":"9","order":500,"question_text":"Data admissão"},{"name":"vs_locality_rh","type":"8","reference":"cmn_location","lookup_table":"sys_user","lookup_value":"u_employee_status","lookup_label":"u_employee_status","order":560,"question_text":"Localidade"},{"name":"vs_department_rh","type":"8","reference":"cmn_department","lookup_table":"sys_user","lookup_value":"u_employee_status","lookup_la