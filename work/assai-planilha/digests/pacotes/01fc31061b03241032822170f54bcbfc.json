n":true}],"ui_policies":[{"sys_id":"530f08ec1b0f649032822170f54bcbc8","short_description":"ALP - Default","conditions":"","actions":["vs_local_cnpj: visible=true,readonly=true","vs_function_imp_inf: visible=true,readonly=true","requested_for: visible=true,readonly=true","rh_date_entry: visible=true,readonly=true","vs_result_center: visible=true,readonly=true","rh_cpf_impacted: visible=true,readonly=true","vs_department_rh: visible=true,readonly=true","rh_email_impacted: visible=true,readonly=true","vs_locality_rh: visible=true,readonly=true","rh_user_id_impacted: visible=true,mandatory=true","rh_date_entry: visible=true,readonly=true"]}],"client_scripts":[{"sys_id":"49cddd6e1b1be810eca40dcbe54bcbd8","name":"ALP - OnChange CPF Validate","type":"onChange","cat_variable":"154f72d41bcf249032822170f54bcbba","va_supported":false,"ui_type":"10","script":"No onChange do CPF do impactado (rh_cpf_impacted), exige 11 dígitos, rejeita sequências repetidas e valida os dois dígitos verificadores. Inválido: limpa o campo e mostra 'CPF inválido!'. Válido: formata o CPF. Contém um console.log de depuração."},{"sys_id":"5679f2bb3b45fa10b28dd047f4e45ac1","name":"ALP - Verify Acompanhar Solicitação","type":"onChange","cat_variable":"5d4f72d41bcf249032822170f54bcbac","ui_type":"10","script":"No onChange do campo de acompanhamento, se o usuário escolhido for igual ao valor de follow_request, limpa follow_request e mostra 'Não é possível adicionar o Impactado para acompanhar a solicitação!'. (Comparação feita contra o próprio follow_request.)"},{"sys_id":"c0ae97c71bc0c1d8eca40dcbe54bcb44","name":"ALP - Hide Fields","type":"onLoad","ui_type":"10","script":"No onLoad, oculta vários campos do colaborador impactado (empresa, cidade, status, centro de resultado, CNPJ da localidade, função, código da função, departamento, localidade). Chama x_asat_csc.CSAAjax.getCatalog e, conforme o retorno, exibe o bloco completo (campos de Gestão de gente) ou, caso contrário, torna obrigatórios rh_company_impacted e rh_city_impacted."},{"sys_id":"cc5a77951b5009d832822170f54bcb56","name":"ALP: SHOW FIELDS RITM","type":"onLoad","applies_catalog":false,"ui_type":"10","script":"No onLoad, oculta campos do colaborador impactado (empresa, cidade, status, centro de resultado, CNPJ do local, função, código da função, departamento, localidade), verificando com hasField antes de mexer em alguns. Chama x_asat_csc.CSAAjax.getCatalog e, conforme o retorno, exibe o bloco completo ou torna obrigatórios empresa e cidade do impactado."},{"sys_id":"ddcda2701bdf6090eca40dcbe54bcb3d","name":"ALP - OnChange User Fields","type":"onChange","cat_variable":"954f72d41bcf249032822170f54bcbb3","ui_type":"10","script":"No onChange da matrícula do impactado, se vazio limpa os campos do colaborador; com valor, chama UserAjax.getUserDataMatricula via GlideAjax e x_asat_csc.CSAAjax.getCatalog. Preenche solicitante, CPF, data de admissão, e-mail, status do colaborador, localidade, departamento, centro de resultado, função, CNPJ do local e código da função com o retorno do usuário, conforme o catálogo retornado (RH ou jurídico), ajustando leitura e obrigatoriedade dos campos."}]},{"sys_id":"1d4f72d41bcf249032822170f54bcb80","title":"Informações do Solicitante","internal_name":"rh_infos_requester_set","order":200,"description":"Conjunto de variáveis para inserir as informações do solicitante.","variaveis":[{"name":"rh_name_requester","type":"8","reference":"sys_user","default_value":"javascript: gs.getUserID();","order":100,"question_text":"Nome do solicitante","read_only":true},{"name":"rh_user_id_requester","type":"6","order":200,"question_text":"Matrícula solicitante"},{"name":"rh_email_requester","type":"6","order":300,"question_text":"E-mail do Solicitante"},{"name":"follow_request","type":"8","reference":"sys_user","reference_qual":"javascript: new global.FilterUtils().filterByRhExpansao(current);","order":400,"question_text":"Acompanhar solicitação","mandatory":true},{"name":"rh_originating","type