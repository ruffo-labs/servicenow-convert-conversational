   "props": {
    "mandatory": true
   }
  },
  "select_the_approver": {
   "props": {
    "mandatory": true
   }
  },
  "email_consultant": {
   "props": {
    "validation_regex": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
   }
  },
  "nova_documento_numero": {
