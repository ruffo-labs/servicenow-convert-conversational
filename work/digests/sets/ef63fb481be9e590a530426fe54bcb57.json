   "label": "Payment type",
   "include_none": true,
   "choices": [
    "Vendors [=suppliers]",
    "Taxes [=taxes]",
    "Utilities [=concessionaires]",
    "Others [=others]",
    "Benefit Sharing",
    "Incentives and Sponsorships"
   ]
  },
  {
   "name": "v_select_request_type_v2",
   "type": "Rótulo",
   "type_code": "11",
   "label": "Select request type"
  },
  {
   "name": "v_early_payment_v2",
   "type": "Caixa de seleção",
   "type_code": "7",
   "label": "Early Payment",
   "mandatory": true
  },
  {
   "name": "v_due_date_extension_v2",
   "type": "Caixa de seleção",
   "type_code": "7",
   "label": "Due Date Extension",
