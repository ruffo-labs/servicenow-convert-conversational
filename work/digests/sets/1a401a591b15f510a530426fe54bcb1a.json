 "ui_policies": [
  {
   "name": "EY: Campos Obrigatorios",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "solicitation_to_whom: mandatory=true"
   ]
  },
  {
   "name": "EY: HTR  When \"Solicitation Whom\" is not \"-- None --\" show \"Employee\" field",
   "when": "IO:solicitation_to_whom=^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "company: visible=false",
    "id_global: visible=false",
    "country: visible=false",
    "discharge_date: visible=false",
    "management_level: visible=false",
    "location: visible=false",
    "position_title: visible=false",
    "manegar_name: visible=false",
    "corporate_email: visible=false",
    "employee: visible=false"
   ]
  },
  {
   "name": "EY: HTR_When \"Solicitation Whom\" is \"None\" doesn't show \"Update information link\"",
   "when": "IO:solicitation_to_whom=^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "information_workday: visible=false"
   ]
  },
  {
   "name": "EY: HTR_When \"Solicitation Whom\" is \"Other employee\" the employee is Mandatory",
   "when": "IO:solicitation_to_whom=another_employee^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "employee: visible=true,mandatory=true",
    "why_opening: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY: HTR_When \"Solicitation Whom\" is \"My request\" show \"Update information link\" , \"Adress\", \"National ID\" , \"name\" fields",
   "when": "IO:solicitation_to_whom=my_request^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "employee: readonly=true",
    "national_id: visible=true",
    "address: visible=true",
    "full_name: visible=true,readonly=true"
   ]
  }
 ],
