fc79061b03241032822170f54bcba6","short_description":"ALP - Solicitação de correção de dados cadastrais","conditions":"service_offering=11d16f541b47649032822170f54bcb2e","actions":["rh_alert_1: visible=true","rh_full_name_newly_admitted: visible=true,mandatory=true","rh_registration_newly_admitted: visible=true,mandatory=true","rh_info_incorrect: visible=true,mandatory=true"]}],"client_scripts":[{"sys_id":"ec38e1d43be72a10b28dd047f4e45a2d","name":"ALP - RH Default Validation User Load","type":"onLoad","cat_variable":"5d4f72d41bcf249032822170f54bcbac","va_supported":false,"ui_type":"10","script":"No onLoad, carrega o UI Script x_asat_csc.RhDefaultValidation e chama checkCatalogItem(g_form). A lógica está no UI Script, não lida aqui."},{"sys_id":"ec647b8e877c4310182a0d440cbb35d5","name":"ALP - Set fixed description","type":"onChange","cat_variable":"154f72d41bcf249032822170f54bcba6","va_supported":false,"ui_type":"10","script":"No onChange da oferta, chama global.GetPropertiesAjax.getProperty para ler o sys_id da oferta de validação de documentação de admissão digital. Se a oferta escolhida for essa, desobriga e bloqueia rh_description e a preenche com um texto padrão do RH sobre pendência de documentação/regularização cadastral na Receita Federal; senão, obriga, libera e limpa a descrição."},{"sys_id":"ef28e9943be72a10b28dd047f4e45aac","name":"ALP - RH Default Validation User Change","type":"onChange","cat_variable":"5d4f72d41bcf249032822170f54bcbac","va_supported":false,"ui_type":"10","script":"No onChange, carrega o UI Script x_asat_csc.RhDefaultValidation e chama validate(g_form). A validação em si está no UI Script, não lida aqui."}],"variable_sets":[{"sys_id":"114f72d41bcf249032822170f54bcb7e","title":"Informações do Impactado","internal_name":"rh_infos_impacted_set","order":100,"description":"Conjunto de variável para inserir as informações do impactado.","variaveis":[{"name":"rh_user_id_impacted","type":"6","order":50,"question_text":"Matrícula do impactado"},{