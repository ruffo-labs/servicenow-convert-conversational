 "client_scripts": [
  {
   "sys_id": "eeff88421b42f490eca40dcbe54bcb35",
   "name": "ALP - Theme",
   "type": "onChange",
   "va_supported": "true",
   "ativo": "true",
   "resumo": "No onChange, limpa e recria as opções da variável theme (13 Salário, Adiantamento salarial, Assistência Médica, Odontológica, Auxílio Funeral, Banco de Horas, etc.), depois roda um switch cujo valor é um sys_id fixo (categoria/fila de RH) e remove as opções que não pertencem àquela categoria (ex.: para 'Operações de Benefícios - Não categorizados' remove 13º salário, adiantamento, banco de horas, comissão, horas extras, folha etc.). Opções e sys_ids fixos no script."
  }
 ]
