 "variable_sets": [
  {
   "sys_id": "2579a7048707f610ec360e530cbb35cb",
   "name": "EY: Informação Básica do colaborador",
   "order": "100",
   "perguntas": [
    "vs_for_who (Selecionar Caixa): Request for whom?",
    "vs_select_the_collaborator (Referência): Select the collaborator",
    "vs_select_collaborators_name (Referência): Collaborator's Name",
    "vs_collaborator_name (Texto de Linha Única): Collaborator's name",
    "vs_collaborato_global_id (Texto de Linha Única): Collaborator's Global ID",
    "vs_collaborator_e_mail (Texto de Linha Única): Corporate Email",
    "vs_public (Texto de Linha Única): Public"
   ]
  }
 ],
 "ui_policies": [
  {
   "name": "EY: Category fields handle HUB",
   "when": "IO:v_learning_category=hub^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_hub_selection: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY - Check if \"for whom\" is \"for me\"",
   "when": "IO:vs_for_who=for_me^ORIO:vs_for_who=^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "vs_select_the_collaborator: visible=false",
    "vs_select_collaborators_name: visible=false"
   ]
  },
  {
   "name": "EY: Check if Category is Cells",
   "when": "IO:v_learning_category=cells^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_name_cell: visible=true"
   ]
  },
  {
   "name": "EY: Check colaborator field",
   "when": "IO:vs_for_who=another_user^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "vs_select_the_collaborator: visible=false",
    "vs_select_collaborators_name: mandatory=true"
   ]
  },
  {
   "name": "EY: Check if  the solicitation is Data ajustment",
   "when": "IO:v_what_is_the_request=existing_djustments^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_ajust_existing_data_attachment: visible=true,mandatory=true"
   ]
  },
  {
   "name": "EY - Fix Variable set Visibility",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "vs_collaborator_name: visible=false,mandatory=false",
    "vs_collaborator_e_mail: visible=false,mandatory=false",
    "vs_for_who: mandatory=true",
    "vs_select_the_collaborator: visible=false,mandatory=false",
    "vs_select_collaborators_name: ",
    "vs_public: visible=false,mandatory=false",
    "vs_collaborato_global_id: visible=false,mandatory=false"
   ]
  },
  {
   "name": "EY: Check if solicitation is data entry",
   "when": "IO:v_what_is_the_request=data_entry^EQ",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_hc_attendance_attachment: visible=true",
    "v_data_required_for_adherence_indicator_2: visible=true",
    "v_the_application_format: visible=true,mandatory=true",
    "v_data_required_for_adherence_indicator_label: visible=true",
    "v_reaction_assessment_attachment: visible=true",
    "v_attachment_of_registered_hc: visible=true",
    "v_attachment_of_eligible_called_hc: visible=true"
   ]
  },
  {
   "name": "EY -  Set RP variables",
   "when": "(sempre)",
   "on_load": true,
   "va_supported": "true",
   "actions": [
    "v_reaction_assessment_attachment: visible=false",
    "v_ajust_existing_data_attachment: visible=false",
    "v_attachment_of_eligible_called_hc: visible=false",
    "v_mandatory_action: mandatory=true",
    "v_the_application_format: visible=false",
    "v_learning_category: mandatory=true",
    "v_extra_comments: mandatory=false",
    "v_hc_attendance_attachment: visible=false",
    "v_name_cell: visible=false",
    "v_hub_selection: visible=false",
    "v_what_is_the_request: mandatory=true",
    "v_data_required_for_adherence_indicator_2: visible=false",
    "v_data_required_for_adherence_indicator_label: visible=false",
    "v_hours_per_class: mandatory=true",
    "v_training_name: mandatory=true",
    "v_attachment_of_registered_hc: visible=false"
   ]
  }
 ],
 "client_scripts": []
}