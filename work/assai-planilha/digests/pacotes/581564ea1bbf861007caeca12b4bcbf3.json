e as mensagens dos aprovadores; se aprovador_1 estiver vazio, limpa aprovador_2 a 6 e mostra 'Necessário aprovador 1' em aprovador_2."},{"sys_id":"6f0ee1fe1b374a1007caeca12b4bcb3a","name":"Field Validation","type":"onSubmit","ui_type":"10","script":"onSubmit. Verifica a cadeia de aprovadores 2 a 6: se um aprovador posterior está preenchido com o anterior vazio, mostra 'Não pode ter aprovador anterior vazio ao posterior' e bloqueia o envio."},{"sys_id":"724a7fc93bc7b250b28dd047f4e45a7e","name":"CSA - Clean Grupo Aprovador","type":"onChange","cat_variable":"154f72d41bcf249032822170f54bcba6","ui_type":"10","script":"No onChange, limpa a variável approver_group."},{"sys_id":"762722a21bb30a1007caeca12b4bcbf3","name":"Aprovador 6","type":"onChange","cat_variable":"0dd8cdea1b37c61007caeca12b4bcbfb","ui_type":"10","script":"No onChange de aprovador_6, esconde as mensagens; se aprovador_5 estiver vazio, limpa aprovador_6 e mostra 'Necessário aprovador 5' em aprovador_6."},{"sys_id":"9782b1d03b6b2a10b28dd047f4e45aec","name":"ALP - RH Default Validation User Change","type":"onChange","cat_variable":"5d4f72d41bcf249032822170f54bcbac","va_supported":false,"ui_type":"10","script":"No onChange, carrega o UI Script x_asat_csc.RhDefaultValidation e chama validate(g_form). A validação em si está no UI Script, não lida aqui."},{"sys_id":"b9e76ae21bb30a1007caeca12b4bcb94","name":"Aprovador 1","type":"onChange","cat_variable":"e3484daa1b37c61007caeca12b4bcb22","ui_type":"10","script":"No onChange de aprovador_1, esconde as mensagens de aprovador_2 a aprovador_6 e limpa os valores de aprovador_2 a aprovador_6 (alterar o primeiro aprovador zera a cadeia seguinte)."},{"sys_id":"baf6d66e1bffc61007caeca12b4bcbe5","name":"Aprovador 3","type":"onChange","cat_variable":"3f880dea1b37c61007caeca12b4bcb92","ui_type":"10","script":"No onChange de aprovador_3, esconde as mensagens; se aprovador_2 estiver vazio, limpa aprovador_3 a 6 e mostra 'Necessário aprovador 2' em aprovador_3."},{"sys_id":"c0b5294d87a40b10182a0d440cbb35ad","name":"ALP - Ocultar Informacoes do Impactado","type":"onChange","cat_variable":"154f72d41bcf249032822170f54bcba6","ui_type":"10","script":"No onChange da oferta, chama x_asat_csc.GetPropertyAjax.getPropertys via GlideAjax para ler a propriedade x_asat_csc.service_offering.sys_id.solicitacao_movimentacao_casada_cd. Se a oferta escolhida for igual ao retorno, oculta, desobriga e limpa os campos de informação do colaborador impactado; senão, exibe e exige esses campos. Versão para Centros de Distribuição."},{"sys_id":"c592b1d03b6b2a10b28dd047f4e45afe","name":"ALP - RH Default Validation User Load","type":"onLoad","cat_variable":"5d4f72d41bcf249032822170f54bcbac","va_supported":false,"ui_type":"10","script":"No onLoad, carrega o UI Script x_asat_csc.RhDefaultValidation e chama checkCatalogItem(g_form). A lógica está no UI Script, não lida aqui."},{"sys_id":"d2cacda21b77c61007caeca12b4bcb1d","name":"Variable Clean","type":"onChange","cat_variable":"d6e749aa1b37c61007caeca12b4bcbd1","ui_type":"10","script":"No onChange, se impacto_financeiro for 'No', limpa estaacima_de_90_da_faixa_fora_da_politica, aprovador_1 a aprovador_6 e approver_group."}],"variable_sets":[{"sys_id":"114f72d41bcf249032822170f54bcb7e","title":"Informações do Impactado","internal_name":"rh_infos_impacted_set","order":100,"description":"Conjunto de variável para inserir as informações do impactado.","variaveis":[{"name":"rh_user_id_impacted","type":"6","order":50,"question_text":"Matrícula do impactado"},{"name":"requested_for","type":"8","reference":"u_all_user","reference_qual":"user_nameISNOTEMPTY^user_user_nameISNOTEMPTY^user_web_service_access_only=false^user_nameNOT LIKE$Usuario^EQ","reference_qual_condition":"user_nameISNOTEMPTY^user_user_nameISNOTEMPTY^user_web_service_access_only=false^user_nameNOT LIKE$Usuario^EQ","order":100,"question_text":"Nome do impactado"},{"name":"rh_cpf_impacted","type":"6","order":300,"question_text":"CPF do impactado"},{"name":"rh_email_impacted","type":"26","order":350,"question_text":"Email"},{"name":"rh_date_entry","type":"9","order":500,"question_text":"Data admissão"},{"name":"vs_locality_rh","type":"8","reference":"cmn_location","lookup_table":"sys_user","lookup_value":"u_employee_status","lookup_label":"u_employee_status","order":560,"question_text":"Localidade"},{"name":"vs_department_rh","type":"8","reference":"cmn_department","lookup_table":"sys_user","lookup_value":"u_employee_status","lookup_label":"u_employee_status","order":570,"question_text":"Departamento"},{"name":"vs_result_center","type":"6","lookup_table":"cmn_department","lookup_value":"id","lookup_label":"id","reference_qual":"javascript: \"sys_id=\" + current.variables.vs_department_rh.toString();","order":580,"question_text":"Centro de resultado"},{"name":"vs_local_cnpj","type":"6","lookup_table":"core_company","lookup_value":"sys_id","lookup_label":"u_cnpj","reference_qual":"javascript: \"sys_id=\" + current.variables.vs_locality_rh.company.toString();","order":590,"question_text":"CNPJ da localidade"},{"name":"vs_function_imp_inf","type":"8","reference":"u_role","lookup_table":"sys_user","lookup_value":"u_employee_status","lookup_label":"u_employee_status","order":592,"question_text":"Função"},{"name":"rh_company_impacted","type":"6","order":595,"question_text":"Empresa"},{"name":"rh_city_impacted","type":"6","order":596,"question_text":"Cidade"},{"name":"not_found_collaborator_vs","type":"7","order":600,"question_text":"Colaborador não encontrado","hidden":true}],"ui_policies":[{"sys_id":"530f08ec1b0f649032822170f54bcbc8","short_description":"ALP - Default","conditions":"","actions":["vs_local_cnpj: visible=true,readonly=true","vs_function_imp_inf: visible=true,readonly=true","requested_for: visible=true,readonly=true","rh_date_entry: visible=true,readonly=true","vs_result_center: visible=true,readonly=true","rh_cpf_impacted: visible=true,readonly=true","vs_department_rh: visible=true,readonly=true","rh_email_impacted: visible=true,readonly=true","vs_locality_rh: visible=true,readonly=true","rh_user_id_impacted: visible=true,mandatory=true","rh_date_entry: visible=true,readonly=true"]}],"client_scripts":[{"sys_id":"49cddd6e1b1be810eca40dcbe54bcbd8","name":"ALP - OnChange CPF Validate","type":"onChange","cat_variable":"154f72d41bcf249032822170f54bcbba","va_supported":false,"ui_type":"10","script":"No onChange do CPF do impactado (rh_cpf_impacted), exige 11 dígitos, rejeita sequências repetidas e valida os dois dígitos verificadores. Inválido: limpa o campo e mostra 'CPF inválido!'. Válido: formata o CPF. Contém um console.log de depuração."},{"sys_id":"5679f2bb3b45fa10b28dd047f4e45ac1","name":"ALP - Verify Acompanhar Solicitação","type":"onChange","cat_variable":"5d4f72d41bcf249032822170f54bcbac","ui_type":"10","script":"No onChange do campo de acompanhamento, se o usuário escolhido for igual ao valor de follow_request, limpa follow_request e mostra 'Não é possível adicionar o Impactado para acompanhar a solicitação!'. (Comparação feita contra o próprio follow_request.)"},{"sys_id":"c0ae97c71bc0c1d8eca40dcbe54bcb44","name":"ALP - Hide Fields","type":"onLoad","ui_type":"10","script":"No onLoad, oculta vários campos do colaborador impactado (empresa, cidade, status, centro de resultado, CNPJ da localidade, função, código da função, departamento, localidade). Chama x_asat_csc.CSAAjax.getCatalog e, conforme o retorno, exibe o bloco completo (campos de Gestão de gente) ou, caso contrário, torna obrigatórios rh_company_impacted e rh_city_impacted."},{"sys_id":"cc5a77951b5009d832822170f54bcb56","name":"ALP: SHOW FIELDS RITM","type":"onLoad","applies_catalog":false,"ui_type":"10","script":"No onLoad, oculta campos do colaborador impactado (empresa, cidade, status, centro de resultado, CNPJ do local, função, código da função, departamento, localidade), verificando com hasField antes de mexer em alguns. Chama x_asat_csc.CSAAjax.getCatalog e, conforme o retorno, exibe o bloco completo ou torna obrigatórios empresa e cidade do impactado."},{"sys_id":"ddcda2701bdf6090eca40dcbe54bcb3d","name":"ALP - OnChange User Fields","type":"onChange","cat_variable":"954f72d41bcf249032822170f54bcbb3","ui_type":"10","script":"No onChange da matrícula do impactado, se vazio limpa os campos do colaborador; com valor, chama UserAjax.getUserDataMatricula via GlideAjax e x_asat_csc.CSAAjax.getCatalog. Preenche solicitante, CPF, data de admissão, e-mail, status do colaborador, localidade, departamento, centro de resultado, função, CNPJ do local e código da função com o retorno do usuário, conforme o catálogo retornado (RH ou jurídico), ajustando leitura e obrigatoriedade dos campos."}]},{"sys_id":"1d4f72d41bcf249032822170f54bcb80","title":"Informações do Solicitante","internal_name":"rh_infos_requester_set","order":200,"description":"Conjunto de variáveis para inserir as informações do solicitante.","variaveis":[{"name":"rh_name_requester","type":"8","reference":"sys_user","default_value":"javascript: gs.getUserID();","order":100,"question_text":"Nome do solicitante","read_only":true},{"name":"rh_user_id_requester","type":"6","order":200,"question_text":"Matrícula solicitante"},{"name":"rh_email_requester","type":"6","order":300,"question_text":"E-mail do Solicitante"},{"name":"follow_request","type":"8","reference":"sys_user","reference_qual":"javascript: new global.FilterUtils().filterByRhExpansao(current);","order":400,"question_text":"Acompanhar solicitação","mandatory":true},{"name":"rh_originating","type":"5","order":500,"question_text":"Procedente","include_none":true,"choices":["Improcedente - Chamado aberto em nome do RH/Solicitante [=unfounded_call_opened_on_behalf_of_hr_applicant]","Improcedente - Chamado aberto fora do prazo [=unfounded_call_opened_after_the_deadline]","Improcedente - Solicitação fora da política [=unfounded_request_outside_the_policy]","Improcedente - Faltou informações básicas [=unfounded_basic_information_missing]","Improcedente - Chamado aberto em duplicidade [=unfounded_duplicate_open_call]","Improcedente - Chamado aberto na linha incorreta [=unfounded_call_opened_on_the_wrong_line]","Improcedente - Cancelamento solicitado pelo RH [=unfounded_cancellation_requested_by_hr]","Improcedente - Rejeição de chamado indevida [=unfounded_improper_call_rejection]","Improcedente - Chamado aberto com dados divergentes [=unfounded_call_opened_with_divergent_data]","Improcedente - Chamado cancelado por falta de retorno solicitante [=unfounded_call_opened_due_to_lack_of_applicant]","Improcedente - Faltou informações/anexos obrigatórios [=unfounded_mandatory_information_attachments_missing]","Improcedente - Cancelado pelo aprovador [=Improcedente - cancelado pelo aprovador]"]}],"ui_policies":[{"sys_id":"e072542c1b4f649032822170f54bcb0e","short_description":"ALP - Default","conditions":"","actions":["rh_email_requester: readonly=true","fde7b4711b3099507a38ea8fe54bcbfc: visible=true","rh_user_id_requester: readonly=true","follow_request: ","rh_name_requester: mandatory=true"]},{"sys_id":"a89df4bd1bf0d990347221bbe54bcb22","short_description":"ALP - Procedente Portal","conditions":"","actions":["rh_originating: visible=false"]}],"client_scripts":[{"sys_id":"38867eb33b45fa10b28dd047f4e45a38","name":"ALP - Verify Acompanhar Solicitação","type":"onChange","cat_variable":"a95726be1bb6f814eca40dcbe54bcb68","ui_type":"10","script":"No onChange, se o usuário escolhido for igual a requested_for (o impactado), limpa follow_request e mostra 'Não é possível adicionar o Impactado para acompanhar a solicitação!'."},{"sys_id":"574ecdfa1b0c3450eca40dcbe54bcb2a","name":"Load requester info","type":"onChange","cat_variable":"a14fb2d41bcf249032822170f54bcb41","ui_type":"10","script":"No onChange do nome do solicitante (rh_name_requester), se vazio limpa id, e-mail e loja do solicitante; com valor chama UserAjax.getUserData via GlideAjax e preenche rh_user_id_requester (user_name), rh_email_requester e rh_store_solic (location)."},{"sys_id":"8fccda911b9f701032822170f54bcbfc","name":"ALP - Hide Acompanhar Solcitação","type":"onLoad","ui_type":"10","script":"No onLoad, oculta follow_request e chama x_asat_csc.CSAAjax.getCatalog com o sys_id do item. O retorno é a lista de catálogos do item; se contiver o catálogo 494f3294... (catálogo de RH mapeado), mostra follow_request."},{"sys_id":"a11a50661b70dd90347221bbe54bcb52","name":"ALP - Hide Procedente","type":"onLoad","applies_catalog":false,"ui_type":"10","script":"No onLoad, oculta rh_originating e chama x_asat_csc.CSAAjax.getCatalog com o cat_item. Se a lista de catálogos retornada incluir 494f3294... (catálogo de RH), mostra rh_originating."}]},{"sys_id":"114f72d41bcf249032822170f54bcb7b","title":"RH Default","internal_name":"rh_what_do_you_want_set","order":250,"description":"Conjunto de variável para inserir o campo o que o cliente quer.","variaveis":[{"name":"service_offering","type":"8","reference":"service_offering","lookup_table":"service_offering","lookup_value":"sys_id","lookup_label":"name","reference_qual":"javascript:new global.AssaiUtils().CSDMGetOfferingsRH(current);","order":100,"question_text":"O que você deseja?","include_none":true}],"ui_policies":[{"sys_id":"47b2546c1b4f649032822170f54bcb9e","short_description":"ALP - Default","conditions":"","actions":["service_offering: mandatory=true"]}],"client_scripts":[{"sys_id":"031d46d71b8b2450eca40dcbe54bcb46","name":"Onchange o que deseja?","type":"onChange","cat_variable":"154f72d41bcf249032822170f54bcba6","ui_type":"10","script":"No onChange, só registra g_form no console (console.log); não altera nenhuma variável. Código de depuração."}]},{"sys_id":"5258528c3ba48b10b28dd047f4e45ae0","title":"Colaborador impactado 1","internal_name":"v_impacted_employee_1","order":1400,"description":"","variaveis":[{"name":"vs_employee_id_1","type":"6","order":100,"question_text":"Matrícula colaborador 1"},{"name":"vs_employee_name_1","type":"8","reference":"u_all_user","reference_qual":"user_nameISNOTEMPT