   "read_only": true,
   "reference": "sys_user",
   "ref_qual": "active=true^EQ"
  },
  {
   "name": "vs_requesters_name",
   "type": "Referência",
   "type_code": "8",
   "label": "Requester's name",
   "reference": "sys_user",
   "ref_qual": "active=true^EQ"
  },
  {
   "name": "vs_which_company",
   "type": "Selecionar Caixa",
   "type_code": "5",
   "label": "Is your request for which company?",
   "include_none": true,
   "choices": [
    "Natura [=natura]",
    "TBS [=tbs]",
    "Avon [=Avon LATAM]"
   ]
  },
  {
